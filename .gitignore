# El sitio usa muy pocas cosas, así que esta lista es corta a propósito.
# Se commitean a propósito, no añadir aquí:
#   data/        los datos crudos y procesados SON parte del repositorio
#   site/dist/   la salida del build, para poder previsualizar y publicar sin compilar

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editores ---
.vscode/
.idea/
*.swp
*.swo

# --- Dependencias ---
node_modules/

# --- Entorno y secretos ---
# El worker live usa un token de la API y credenciales de Cloudflare: nunca al repo.
.env
.env.*
!.env.example
.dev.vars

# --- Herramientas ---
.wrangler/
.cache/

# --- Logs y temporales ---
*.log
npm-debug.log*
tmp/
*.tmp
